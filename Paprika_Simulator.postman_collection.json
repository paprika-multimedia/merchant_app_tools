  "item": [
    {
      "name": "🏥 Health Check",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/health",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "health"
              ]
            },
            "description": "Cek apakah server simulator sedang berjalan."
          },
          "response": [
            {
              "name": "OK",
              "status": "OK",
              "code": 200,
              "body": "{\"status\":\"ok\"}"
            }
          ]
        }
      ]
    },
    {
      "name": "🔐 Auth — Sessions",
      "item": [
        {
          "name": "Claim Session (Login)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.session_token) {",
                  "    pm.collectionVariables.set('token', res.session_token);",
                  "    console.log('✅ Token saved:', res.session_token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"company_code\": \"A4F28K19PQ7M3XR9LB42\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/v1/sessions/claim",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "v1",
                "sessions",
                "claim"
              ]
            },
            "description": "Login menggunakan company code. Script otomatis menyimpan `session_token` ke variable koleksi.\n\n**Company code fixture:** `A4F28K19PQ7M3XR9LB42`"
          }
        },
        {
          "name": "Refresh Session",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh_token\": \"mock_refresh_token_90d\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/v1/sessions/refresh",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "v1",
                "sessions",
                "refresh"
              ]
            },
            "description": "Refresh session token menggunakan refresh token."
          }
        },
        {
          "name": "Logout Session",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{base_url}}/v1/sessions/logout",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "v1",
                "sessions",
                "logout"
              ]
            },
            "description": "🔒 Logout dan cabut sesi aktif. Response: 204 No Content."
